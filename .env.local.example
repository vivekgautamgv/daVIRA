# No environment file is required for local development.
# npm run dev generates a private engine token for each session.
APP_HOST=127.0.0.1
PORT=3000
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8787
DAVIRA_DB_PATH=data/davira.sqlite

# Set these only for a private remote pilot. Never use NEXT_PUBLIC_ for secrets.
# APP_PASSWORD=choose-a-unique-password-at-least-16-characters
# ENGINE_TOKEN=choose-a-random-secret-at-least-32-characters
# ENGINE_URL=http://127.0.0.1:8787
